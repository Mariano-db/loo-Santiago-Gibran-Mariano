package com.anahuac.astore.seguridad;

import java.util.EnumSet;
import java.util.Set;


public class Administrador extends Usuario {

    public Administrador(String id, String nombre, String username, String email,
                         String password) {
        super(id, nombre, username, email, password, Rol.administrador());
    }

    @Override
    public String descripcionRol() {
        return "Administrador - acceso total al sistema";
    }

    @Override
    public Set<Permiso> permisosBase() {
        return EnumSet.allOf(Permiso.class);  
    }
}
